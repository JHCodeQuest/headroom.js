{
  "name": "headroom.js",
  "version": "0.12.0",
  "description": "Give your page some headroom. Hide your header until you need it",
  "main": "dist/headroom.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run build && cypress open",
    "test": "npm run build && npm run test:package && npm run test:types && npm run test:browser",
    "build": "rollup --config rollup.config.mjs && node scripts/build-types.mjs && tsc -p examples/typescript/tsconfig.json",
    "lint": "eslint .",
    "test:browser": "cypress run --browser chrome",
    "check": "npm run lint && npm test",
    "test:package": "node --test test/package.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prepack": "npm run build",
    "demo": "node scripts/serve-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JHCodeQuest/headroom.js.git"
  },
  "keywords": [
    "header",
    "fixed",
    "scroll",
    "menu"
  ],
  "author": "Nick Williams",
  "homepage": "https://github.com/JHCodeQuest/headroom.js#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JHCodeQuest/headroom.js/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "rollup": "^4.64.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "private": true,
  "module": "dist/headroom.mjs",
  "types": "dist/headroom.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/headroom.d.mts",
        "default": "./dist/headroom.mjs"
      },
      "require": {
        "types": "./dist/headroom.d.cts",
        "default": "./dist/headroom.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./dist/headroom.js": {
      "types": "./dist/headroom.d.cts",
      "default": "./dist/headroom.js"
    },
    "./dist/headroom.min.js": {
      "types": "./dist/headroom.d.cts",
      "default": "./dist/headroom.min.js"
    },
    "./dist/headroom": {
      "types": "./dist/headroom.d.cts",
      "default": "./dist/headroom.js"
    },
    "./dist/headroom.min": {
      "types": "./dist/headroom.d.cts",
      "default": "./dist/headroom.min.js"
    },
    "./dist/headroom.mjs": {
      "types": "./dist/headroom.d.mts",
      "default": "./dist/headroom.mjs"
    }
  }
}
